---
import type { Drawing } from "../lib/types";
import type { Locale } from "../lib/types";
import { assetPath, drawingDescription, drawingTitle, getEntryThumbnail } from "../lib/types";
import { getUi } from "../lib/i18n";

interface Props {
  drawing: Drawing;
  locale: Locale;
  index?: number;
}

const { drawing, locale, index = 0 } = Astro.props;
const strings = getUi(locale);
const isGroup = drawing.grouped === "multiple";
const thumbnail = getEntryThumbnail(drawing);
const title = drawingTitle(drawing, locale);
const images = isGroup ? (drawing.images ?? []) : [drawing.image ?? ""];
const lightboxData = JSON.stringify({
  title,
  description: drawingDescription(drawing, locale),
  year: drawing.year ?? "",
  images: images.map((img) => assetPath(img)),
});
---

<button
  type="button"
  class="gallery-item"
  role="listitem"
  aria-label={isGroup ? strings.gallery.openGroup(title) : strings.gallery.openItem(title)}
  data-lightbox={lightboxData}
>
  <div class="gallery-item-media">
    <img
      class="gallery-item-image"
      src={assetPath(thumbnail)}
      alt={drawingDescription(drawing, locale) || title}
      loading={index >= 3 ? "lazy" : "eager"}
      width="400"
      height="400"
    />
    {
      isGroup && (
        <span class="gallery-item-group-badge" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v8.25A2.25 2.25 0 0 0 6 16.5h2.25m8.25-8.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-7.5A2.25 2.25 0 0 1 8.25 18v-1.5m8.25-8.25h-6a2.25 2.25 0 0 0-2.25 2.25v6" /></svg>
        </span>
      )
    }
  </div>
  <div class="gallery-item-info">
    <h3 class="gallery-item-title">{title}</h3>
    {drawing.year && <p class="gallery-item-year">{drawing.year}</p>}
  </div>
</button>
