---
import type { Project } from "../lib/types";
import type { Locale } from "../lib/types";
import { assetPath, projectName } from "../lib/types";
import { getUi, localizedPath } from "../lib/i18n";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const strings = getUi(locale);
const name = projectName(project, locale);
---

<a
  href={localizedPath(`/progetti/${project.id}/`, locale)}
  class="project-card"
  role="listitem"
  aria-label={strings.projects.openProject(name)}
>
  <div class="project-card-media">
    <img
      class="project-card-image"
      src={assetPath(project.cover)}
      alt={name}
      loading="lazy"
      width="400"
      height="500"
    />
  </div>
  <div class="project-card-info">
    <h3 class="project-card-title">{name}</h3>
    {project.year && <p class="project-card-year">{project.year}</p>}
  </div>
</a>
