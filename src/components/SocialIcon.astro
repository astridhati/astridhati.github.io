---
import type { Locale } from "../lib/types";
import { socialAriaLabel, socialLabel } from "../lib/i18n";

interface Props {
  platform: string;
  url: string;
  locale?: Locale;
  external?: boolean;
}

const { platform, url, locale = "it", external = true } = Astro.props;
const label = socialAriaLabel(platform, locale, external);
const tooltip = socialLabel(platform, locale);
---

<a
  href={url}
  class="nav-icon"
  aria-label={label}
  title={tooltip}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {
    platform === "instagram" && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
    )
  }
  {
    platform === "email" && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
