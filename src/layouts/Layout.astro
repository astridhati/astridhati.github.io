---
import "../styles/styles.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import SEO from "../components/SEO.astro";
import { getSite } from "../lib/content";
import { getUi, localizedPath, stripLocalePrefix } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { locale = "it", title, description, image, canonical, type, jsonLd } = Astro.props;
const site = getSite();
const currentPath = Astro.url.pathname;
const strings = getUi(locale);
const siteBase = Astro.site?.href ?? "https://astridhati.github.io/";
const pathWithoutLocale = stripLocalePrefix(currentPath);
const itUrl = new URL(localizedPath(pathWithoutLocale, "it"), siteBase).href;
const enUrl = new URL(localizedPath(pathWithoutLocale, "en"), siteBase).href;
const canonicalUrl = canonical ?? new URL(currentPath, siteBase).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      href="/fonts/Myfont-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <SEO
      locale={locale}
      title={title}
      description={description}
      image={image}
      canonical={canonicalUrl}
      itUrl={itUrl}
      enUrl={enUrl}
      type={type}
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <Header site={site} locale={locale} currentPath={currentPath} />
    <main class="page">
      <slot />
    </main>
    <Footer site={site} />
    <Lightbox labels={strings.lightbox} />
  </body>
</html>
