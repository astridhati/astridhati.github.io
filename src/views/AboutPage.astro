---
import Layout from "../layouts/Layout.astro";
import ProtectedMedia from "../components/ProtectedMedia.astro";
import { getSite } from "../lib/content";
import { getUi, localizedPath, siteAboutTitle, siteBio, siteName } from "../lib/i18n";
import { assetPath, type Locale } from "../lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite();
const strings = getUi(locale);
const siteUrl = "https://astridhati.github.io";
const canonical = `${siteUrl}${localizedPath("/chi-sono/", locale)}`;
const pageTitle = siteAboutTitle(site, locale);
const aboutImage = site.identity.image?.trim();

const title = strings.about.pageTitle(siteName(site), pageTitle);
const description = siteBio(site, locale).slice(0, 160);
---

<Layout locale={locale} title={title} description={description} canonical={canonical}>
  <section class="about section" aria-labelledby="about-title">
    <div class="container stack stack--md stack--pad-top">
      <h1 id="about-title" class="section-title">{pageTitle}</h1>
      <div class="about-layout">
        <div class="about-content">
          <p class="about-bio">{siteBio(site, locale)}</p>
        </div>
        <figure
          class:list={["about-portrait", { "about-portrait--placeholder": !aboutImage }]}
        >
          {
            aboutImage && (
              <ProtectedMedia
                src={assetPath(aboutImage)}
                alt={siteName(site)}
                class="about-portrait-image"
                width={400}
                height={500}
                loading="lazy"
                decoding="async"
              />
            )
          }
        </figure>
      </div>
    </div>
  </section>
</Layout>
