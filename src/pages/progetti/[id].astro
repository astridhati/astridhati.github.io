---
import ProjectDetailPage from "../../views/ProjectDetailPage.astro";
import { getProject, getProjectIds } from "../../lib/content";
import { localizedPath } from "../../lib/i18n";

export function getStaticPaths() {
  return getProjectIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const project = getProject(id!);

if (!project) {
  return Astro.redirect("/progetti/");
}
---

<ProjectDetailPage locale="it" project={project} />
