---
import Layout from "../layouts/Layout.astro";
import GalleryFilters from "../components/GalleryFilters.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import {
  getCategories,
  getDrawingsByCategory,
  getGalleryDrawings,
  getSite,
} from "../lib/content";
import {
  getUi,
  localizedPath,
  siteGalleryEmpty,
  siteGalleryIntro,
  siteGalleryTitle,
  siteName,
} from "../lib/i18n";
import { getSiteUrl } from "../lib/seo";
import type { Locale } from "../lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite();

const categories = getCategories().filter(
  (category) => getDrawingsByCategory(category.id).length > 0,
);
const drawings = getGalleryDrawings();
const strings = getUi(locale);
const siteUrl = getSiteUrl(Astro.site?.href);
const canonical = `${siteUrl}${localizedPath("/galleria/", locale)}`;
const pageTitle = siteGalleryTitle(site, locale);

const title = strings.gallery.pageTitle(siteName(site), pageTitle);
const description = strings.gallery.pageDescription(siteName(site));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  isPartOf: {
    "@type": "WebSite",
    name: siteName(site),
    url: siteUrl,
  },
};
---

<Layout
  locale={locale}
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <section class="gallery section" aria-labelledby="gallery-title">
    <div class="container stack stack--md stack--pad-top" data-gallery-browser>
      <h1 id="gallery-title" class="section-title">{pageTitle}</h1>
      <p class="gallery-intro">{siteGalleryIntro(site, locale)}</p>
      {
        categories.length > 0 && (
          <GalleryFilters categories={categories} locale={locale} />
        )
      }
      <GalleryGrid
        drawings={drawings}
        locale={locale}
        emptyMessage={siteGalleryEmpty(site, locale)}
        filterEmptyMessage={strings.gallery.filterEmpty}
      />
    </div>
  </section>
  <script>
    import "../scripts/gallery-filters.ts";
  </script>
</Layout>
