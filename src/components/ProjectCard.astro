---
import type { Project } from "../lib/types";
import { assetPath } from "../lib/types";

interface Props {
  project: Project;
  asLink?: boolean;
}

const { project, asLink = true } = Astro.props;
---

{
  asLink ? (
    <a
      href={`/progetti/${project.id}/`}
      class="project-card"
      role="listitem"
      aria-label={`Apri progetto ${project.name}`}
    >
      <div class="project-card-image-wrap">
        <img
          class="project-card-image"
          src={assetPath(project.cover)}
          alt={project.name}
          loading="lazy"
          width="600"
          height="400"
        />
      </div>
      <div class="project-card-body">
        <h3 class="project-card-title">{project.name}</h3>
        {project.year && <p class="project-card-year">{project.year}</p>}
        {project.description && (
          <p class="project-card-description">{project.description}</p>
        )}
      </div>
    </a>
  ) : (
    <article class="project-card" role="listitem">
      <div class="project-card-image-wrap">
        <img
          class="project-card-image"
          src={assetPath(project.cover)}
          alt={project.name}
          loading="lazy"
          width="600"
          height="400"
        />
      </div>
      <div class="project-card-body">
        <h3 class="project-card-title">{project.name}</h3>
        {project.year && <p class="project-card-year">{project.year}</p>}
        {project.description && (
          <p class="project-card-description">{project.description}</p>
        )}
      </div>
    </article>
  )
}

<style>
  a.project-card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform var(--transition);
  }

  a.project-card:hover {
    transform: translateY(-2px);
  }
</style>
