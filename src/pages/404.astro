---
import Layout from "../layouts/Layout.astro";
import { getSite } from "../lib/content";
import { getLocaleFromPath, getUi, localizedPath, siteName } from "../lib/i18n";
import { getSiteUrl } from "../lib/seo";

const locale = getLocaleFromPath(Astro.url.pathname);
const site = getSite();
const strings = getUi(locale);
const siteUrl = getSiteUrl(Astro.site?.href);
const homeHref = localizedPath("/", locale);
const title = `${strings.notFound.title} — ${siteName(site)}`;
const description = strings.notFound.description;
const canonical = `${siteUrl}${Astro.url.pathname}`;
---

<Layout
  locale={locale}
  title={title}
  description={description}
  canonical={canonical}
  noindex={true}
>
  <section class="section" aria-labelledby="not-found-title">
    <div class="container stack stack--md stack--pad-top">
      <h1 id="not-found-title" class="section-title">{strings.notFound.heading}</h1>
      <p>{strings.notFound.message}</p>
      <a href={homeHref} class="contact-button not-found__home">{strings.notFound.home}</a>
    </div>
  </section>
</Layout>

<style lang="scss">
  .not-found__home {
    align-self: flex-start;
  }
</style>
