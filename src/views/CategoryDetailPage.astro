---
import Layout from "../layouts/Layout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { getDrawingsByCategory, getSite } from "../lib/content";
import {
  categoryDescription,
  categoryName,
  categorySeoDescription,
  categorySeoTitle,
} from "../lib/types";
import type { Category, Locale } from "../lib/types";
import {
  localizedPath,
  siteCategoriesEmpty,
  siteName,
} from "../lib/i18n";
import { absoluteAssetUrl, getSiteUrl, truncateDescription } from "../lib/seo";

interface Props {
  locale: Locale;
  category: Category;
}

const { locale, category } = Astro.props;
const site = getSite();
const drawings = getDrawingsByCategory(category.id);
const siteUrl = getSiteUrl(Astro.site?.href);
const canonical = `${siteUrl}${localizedPath(`/categorie/${category.id}/`, locale)}`;

const title = categorySeoTitle(category, siteName(site), locale);
const description = truncateDescription(
  categorySeoDescription(category, siteName(site), locale),
);
const name = categoryName(category, locale);
const intro = categoryDescription(category, locale);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name,
  description: intro || description,
  url: canonical,
  image: absoluteAssetUrl(site.header.logo, siteUrl),
};
---

<Layout
  locale={locale}
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <section class="category section" aria-labelledby="category-title">
    <div class="container stack stack--lg stack--pad-top">
      <header class="category-header stack stack--sm">
        <h1 id="category-title" class="section-title">{name}</h1>
        {category.year && <p class="category-year">{category.year}</p>}
        {intro && <p class="category-description">{intro}</p>}
      </header>

      <div class="stack stack--md">
        <hr class="category-works-divider" aria-hidden="true" />
        <GalleryGrid
          drawings={drawings}
          locale={locale}
          emptyMessage={siteCategoriesEmpty(site, locale)}
        />
      </div>
    </div>
  </section>
</Layout>
