---
import type { Project } from "../lib/types";
import type { Locale } from "../lib/types";
import { assetPath, projectDescription, projectName } from "../lib/types";
import { getUi, localizedPath } from "../lib/i18n";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const strings = getUi(locale);
const name = projectName(project, locale);
---

<a
  href={localizedPath(`/progetti/${project.id}/`, locale)}
  class="project-card"
  role="listitem"
  aria-label={strings.projects.openProject(name)}
>
  <div class="project-card-image-wrap">
    <img
      class="project-card-image"
      src={assetPath(project.cover)}
      alt={name}
      loading="lazy"
      width="600"
      height="400"
    />
  </div>
  <div class="project-card-body">
    <h3 class="project-card-title">{name}</h3>
    {project.year && <p class="project-card-year">{project.year}</p>}
    {projectDescription(project, locale) && (
      <p class="project-card-description">{projectDescription(project, locale)}</p>
    )}
  </div>
</a>

<style>
  a.project-card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform var(--transition);
  }

  a.project-card:hover {
    transform: translateY(-2px);
  }
</style>
