---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getSite } from "../lib/content";
import {
  homeTitle,
  localizedPath,
  navRoutes,
  siteBio,
  siteHomeGalleryButton,
  siteName,
  siteTagline,
  siteWelcome,
} from "../lib/i18n";
import { absoluteAssetUrl, getSiteUrl, truncateDescription } from "../lib/seo";
import type { Locale } from "../lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite();
const welcome = siteWelcome(site, locale);
const galleryButton = siteHomeGalleryButton(site, locale);

const title = homeTitle(site, locale);
const description = truncateDescription(siteBio(site, locale));
const siteUrl = getSiteUrl(Astro.site?.href);
const canonical = locale === "en" ? `${siteUrl}/en/` : `${siteUrl}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteName(site),
  description: siteBio(site, locale),
  url: canonical,
  jobTitle: siteTagline(site, locale),
  image: absoluteAssetUrl(site.header.logo, siteUrl),
  sameAs: Object.values(site.footer.social ?? {}).filter(Boolean),
};
---

<Layout
  locale={locale}
  title={title}
  description={description}
  image={site.header.logo}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <Hero site={site} locale={locale} />

  {
    (welcome || galleryButton) && (
      <section class="home-welcome section">
        <div class="container">
          {welcome && <p class="home-welcome__text">{welcome}</p>}
          {galleryButton && (
            <a
              href={localizedPath(navRoutes.gallery, locale)}
              class="contact-button home-welcome__cta"
            >
              {galleryButton}
            </a>
          )}
        </div>
      </section>
    )
  }
</Layout>

<style lang="scss">
  .home-welcome {
    text-align: center;
  }

  .home-welcome__text {
    max-width: 36rem;
    margin: 0 auto;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .home-welcome__cta {
    margin-top: 1.75rem;
    padding: 0.9375rem 2.0625rem;
    padding-left: calc(2.0625rem + 0.08em);
    font-size: 1.40625rem;
    letter-spacing: 0.08em;
    border-radius: 999px;
    white-space: nowrap;
  }
</style>
