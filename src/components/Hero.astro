---
import type { SiteConfig } from "../lib/types";
import { assetPath } from "../lib/types";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const heroStyle = site.heroBackground
  ? `background-image: url("${assetPath(site.heroBackground)}")`
  : undefined;
---

<section id="hero" class:list={["hero", { "hero--has-background": !!site.heroBackground }]} aria-label="Introduzione" style={heroStyle}>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-content container">
    <h1 class="hero-title">{site.name}</h1>
    {site.tagline && <p class="hero-tagline">{site.tagline}</p>}
  </div>
</section>

<style>
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: var(--space-xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .hero-tagline {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
</style>
