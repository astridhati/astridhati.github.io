---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getSite } from "../lib/content";
import { homeTitle, siteBio, siteName, siteTagline, siteWelcome } from "../lib/i18n";
import { absoluteAssetUrl, getSiteUrl, truncateDescription } from "../lib/seo";
import type { Locale } from "../lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite();
const welcome = siteWelcome(site, locale);

const title = homeTitle(site, locale);
const description = truncateDescription(siteBio(site, locale));
const siteUrl = getSiteUrl(Astro.site?.href);
const canonical = locale === "en" ? `${siteUrl}/en/` : `${siteUrl}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteName(site),
  description: siteBio(site, locale),
  url: canonical,
  jobTitle: siteTagline(site, locale),
  image: absoluteAssetUrl(site.header.logo, siteUrl),
  sameAs: Object.values(site.footer.social ?? {}).filter(Boolean),
};
---

<Layout
  locale={locale}
  title={title}
  description={description}
  image={site.header.logo}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <Hero site={site} locale={locale} />

  {
    welcome && (
      <section class="home-welcome section">
        <div class="container">
          <p class="home-welcome__text">{welcome}</p>
        </div>
      </section>
    )
  }
</Layout>

<style lang="scss">
  .home-welcome {
    text-align: center;
  }

  .home-welcome__text {
    max-width: 36rem;
    margin: 0 auto;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
