---
import type { SiteConfig } from "../lib/types";
import type { Locale } from "../lib/types";
import SocialIcon from "./SocialIcon.astro";
import { getUi, siteName } from "../lib/i18n";

interface Props {
  site: SiteConfig;
  locale: Locale;
}

const { site, locale } = Astro.props;
const strings = getUi(locale);
const year = new Date().getFullYear();
const hasSocial =
  site.footer.social && Object.values(site.footer.social).some((url) => Boolean(url));
---

<footer class="site-footer">
  {
    (hasSocial || site.footer.email) && (
      <div class="site-footer__contact">
        {
          hasSocial && (
            <div class="site-footer__social nav-actions" aria-label={strings.footer.social}>
              {
                Object.entries(site.footer.social).map(([platform, url]) =>
                  url ? <SocialIcon platform={platform} url={url} locale={locale} /> : null,
                )
              }
            </div>
          )
        }
        {
          site.footer.email && (
            <a class="site-footer__email" href={`mailto:${site.footer.email}`}>
              {site.footer.email}
            </a>
          )
        }
      </div>
    )
  }
  <div class="site-footer__legal">
    <p class="site-footer__byline">
      <span class="site-footer__symbol">&copy;</span> {year} {siteName(site)}
    </p>
    <p class="site-footer__copy">{strings.footer.rightsReserved}</p>
  </div>
</footer>
