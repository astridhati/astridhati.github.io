---
import ProtectedMedia from "./ProtectedMedia.astro";
import type { SiteConfig } from "../lib/types";
import { assetPath } from "../lib/types";
import type { Locale } from "../lib/types";
import { getUi, homeTitle } from "../lib/i18n";

interface Props {
  site: SiteConfig;
  locale: Locale;
}

const { site, locale } = Astro.props;
const strings = getUi(locale);
const heroBackground = site.home.heroBackground?.trim();
const title = homeTitle(site, locale);
---

<section
  id="hero"
  class:list={["hero", { "hero--has-background": !!heroBackground }]}
  aria-label={strings.hero.aria}
>
  <h1 class="hero-title">{title}</h1>
  {
    heroBackground && (
      <ProtectedMedia
        src={assetPath(heroBackground)}
        alt=""
        class="hero-image"
        width={1024}
        height={576}
        loading="eager"
        decoding="async"
      />
    )
  }
</section>
