---
import Layout from "../layouts/Layout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { getSite } from "../lib/content";
import { mailtoLink } from "../lib/email";
import {
  getUi,
  localizedPath,
  siteContactEmailButton,
  siteContactEmailPrefix,
  siteContactIntro,
  siteContactSocialHeading,
  siteContactTitle,
  siteName,
} from "../lib/i18n";
import type { Locale } from "../lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite();
const strings = getUi(locale);
const siteUrl = "https://astridhati.github.io";
const canonical = `${siteUrl}${localizedPath("/contatti/", locale)}`;
const pageTitle = siteContactTitle(site, locale);

const title = strings.contact.pageTitle(siteName(site), pageTitle);
const description = strings.contact.pageDescription(siteName(site));
---

<Layout locale={locale} title={title} description={description} canonical={canonical}>
  <section class="contact section" aria-labelledby="contact-title">
    <div class="container stack stack--lg stack--pad-top">
      <h1 id="contact-title" class="section-title">{pageTitle}</h1>
      <p class="contact-intro">{siteContactIntro(site, locale)}</p>
      {
        site.footer.email && (
          <div class="contact-email stack stack--sm">
            <p class="contact-email-desktop">
              {siteContactEmailPrefix(site, locale)}{" "}
              <strong>{site.footer.email}</strong>
            </p>
            <a class="contact-button contact-email-mobile" href={mailtoLink(site.footer.email)}>
              {siteContactEmailButton(site, locale)}
            </a>
          </div>
        )
      }
      {
        site.footer.social &&
          Object.values(site.footer.social).some(Boolean) && (
          <div class="contact-social stack stack--sm">
            <h2 class="contact-social-title">{siteContactSocialHeading(site, locale)}</h2>
            <div class="nav-actions">
              {
                Object.entries(site.footer.social).map(([platform, url]) =>
                  url ? <SocialIcon platform={platform} url={url} /> : null,
                )
              }
            </div>
          </div>
        )
      }
    </div>
  </section>
</Layout>
