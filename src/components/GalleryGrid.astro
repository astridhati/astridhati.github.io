---
import type { Drawing } from "../lib/types";
import type { Locale } from "../lib/types";
import GalleryItem from "./GalleryItem.astro";

interface Props {
  drawings: Drawing[];
  locale: Locale;
  emptyMessage?: string;
  filterEmptyMessage?: string;
}

const { drawings, locale, emptyMessage, filterEmptyMessage } = Astro.props;
---

<div class="gallery-grid" role="list">
  {
    drawings.length === 0 ? (
      <p class="gallery-empty">{emptyMessage}</p>
    ) : (
      <>
        {drawings.map((drawing, index) => (
          <GalleryItem drawing={drawing} locale={locale} index={index} />
        ))}
        {filterEmptyMessage && (
          <p class="gallery-empty gallery-empty--filtered" hidden>
            {filterEmptyMessage}
          </p>
        )}
      </>
    )
  }
</div>

<script>
  import "../scripts/lightbox.ts";
</script>
