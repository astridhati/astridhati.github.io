---
import ProtectedMedia from "./ProtectedMedia.astro";
import type { Drawing } from "../lib/types";
import type { Locale } from "../lib/types";
import {
  assetPath,
  drawingCategoryId,
  drawingDescription,
  drawingTitle,
  getEntryThumbnail,
} from "../lib/types";
import { drawingGroupPath, getUi } from "../lib/i18n";

interface Props {
  drawing: Drawing;
  locale: Locale;
  index?: number;
}

const { drawing, locale, index = 0 } = Astro.props;
const strings = getUi(locale);
const isGroup = drawing.grouped === "multiple";
const thumbnail = getEntryThumbnail(drawing);
const title = drawingTitle(drawing, locale);
const categoryId = drawingCategoryId(drawing) || "";

const lightboxData = JSON.stringify({
  title,
  description: drawingDescription(drawing, locale),
  year: drawing.year ?? "",
  images: [assetPath(drawing.image ?? "")],
});
---

{
  isGroup ? (
    <a
      href={drawingGroupPath(drawing.id, locale)}
      class="gallery-item"
      data-category={categoryId}
      role="listitem"
      aria-label={strings.gallery.viewGroup(title)}
    >
      <div class="gallery-item-media">
        <ProtectedMedia
          class="gallery-item-image"
          src={assetPath(thumbnail)}
          alt={drawingDescription(drawing, locale) || title}
          loading={index >= 3 ? "lazy" : "eager"}
          width={400}
          height={400}
        />
      </div>
    </a>
  ) : (
    <button
      type="button"
      class="gallery-item"
      data-category={categoryId}
      role="listitem"
      aria-label={strings.gallery.openItem(title)}
      data-lightbox={lightboxData}
    >
      <div class="gallery-item-media">
        <ProtectedMedia
          class="gallery-item-image"
          src={assetPath(thumbnail)}
          alt={drawingDescription(drawing, locale) || title}
          loading={index >= 3 ? "lazy" : "eager"}
          width={400}
          height={400}
        />
      </div>
    </button>
  )
}
