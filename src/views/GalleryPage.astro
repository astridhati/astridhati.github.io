---
import Layout from "../layouts/Layout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { getGalleryDrawings, getSite } from "../lib/content";
import { getUi, localizedPath } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite();
const drawings = getGalleryDrawings();
const strings = getUi(locale);
const siteUrl = "https://astridhati.github.io";
const canonical = `${siteUrl}${localizedPath("/galleria/", locale)}`;

const title = strings.gallery.pageTitle(site.name);
const description = strings.gallery.pageDescription(site.name);
---

<Layout locale={locale} title={title} description={description} canonical={canonical}>
  <section class="gallery section" aria-labelledby="gallery-title">
    <div class="container stack stack--md stack--pad-top">
      <h1 id="gallery-title" class="section-title">{strings.gallery.title}</h1>
      <p class="gallery-intro">{strings.gallery.intro}</p>
      <GalleryGrid
        drawings={drawings}
        locale={locale}
        emptyMessage={strings.gallery.empty}
      />
    </div>
  </section>
</Layout>
