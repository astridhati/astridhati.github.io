---
import "../styles/styles.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import SEO from "../components/SEO.astro";
import { getSite } from "../lib/content";
import { getUi, localizedPath, siteName, stripLocalePrefix } from "../lib/i18n";
import { assetPath } from "../lib/types";
import type { Locale } from "../lib/types";

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  type?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale = "it",
  title,
  description,
  image,
  imageAlt,
  canonical,
  type,
  noindex,
  jsonLd,
} = Astro.props;
const site = getSite();
const strings = getUi(locale);
const currentPath = Astro.url.pathname;
const siteBase = Astro.site?.href ?? "https://astridhati.github.io/";
const pathWithoutLocale = stripLocalePrefix(currentPath);
const itUrl = new URL(localizedPath(pathWithoutLocale, "it"), siteBase).href;
const enUrl = new URL(localizedPath(pathWithoutLocale, "en"), siteBase).href;
const canonicalUrl = canonical ?? new URL(currentPath, siteBase).href;
const seoImage = image ?? site.header.logo;
const seoImageAlt = imageAlt ?? siteName(site);
const name = siteName(site);
const logoWebp = site.header.logo ? assetPath(site.header.logo.replace(/\.png$/i, ".webp")) : undefined;
const faviconPath = site.header.logo ? assetPath(site.header.logo) : "/favicon.svg";
const faviconType = site.header.logo ? "image/png" : "image/svg+xml";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={faviconPath} type={faviconType} />
    {site.header.logo && <link rel="apple-touch-icon" href={faviconPath} />}
    {
      logoWebp && (
        <link rel="preload" href={logoWebp} as="image" type="image/webp" />
      )
    }
    <link
      rel="preload"
      href="/fonts/Myfont-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEO
      locale={locale}
      title={title}
      description={description}
      image={seoImage}
      imageAlt={seoImageAlt}
      canonical={canonicalUrl}
      itUrl={itUrl}
      enUrl={enUrl}
      type={type}
      noindex={noindex}
      siteName={name}
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">{strings.skipToContent}</a>
    <Header site={site} locale={locale} currentPath={currentPath} />
    <main id="main-content" class="page">
      <slot />
    </main>
    <Footer site={site} locale={locale} />
    <Lightbox labels={strings.lightbox} />
  </body>
</html>

<script>
  import "../scripts/image-protection.ts";
</script>
