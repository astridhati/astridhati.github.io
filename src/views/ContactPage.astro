---
import Layout from "../layouts/Layout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { getSite } from "../lib/content";
import { mailtoLink } from "../lib/email";
import { getUi, localizedPath } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite();
const strings = getUi(locale);
const siteUrl = "https://astridhati.github.io";
const canonical = `${siteUrl}${localizedPath("/contatti/", locale)}`;

const title = strings.contact.pageTitle(site.name);
const description = strings.contact.pageDescription(site.name);
---

<Layout locale={locale} title={title} description={description} canonical={canonical}>
  <section class="contact section" aria-labelledby="contact-title">
    <div class="container stack stack--lg stack--pad-top">
      <h1 id="contact-title" class="section-title">{strings.contact.title}</h1>
      <p class="contact-intro">{strings.contact.intro}</p>
      {
        site.email && (
          <div class="contact-email stack stack--sm">
            <p class="contact-email-desktop">
              {strings.contact.emailAtPrefix}{" "}
              <strong>{site.email}</strong>
            </p>
            <a class="contact-button contact-email-mobile" href={mailtoLink(site.email)}>
              {strings.contact.email}
            </a>
          </div>
        )
      }
      {
        site.social && Object.keys(site.social).length > 0 && (
          <div class="contact-social stack stack--sm">
            <h2 class="contact-social-title">{strings.contact.social}</h2>
            <div class="nav-actions">
              {
                Object.entries(site.social).map(([platform, url]) =>
                  url ? <SocialIcon platform={platform} url={url} /> : null,
                )
              }
            </div>
          </div>
        )
      }
    </div>
  </section>
</Layout>
