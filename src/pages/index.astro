---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectsCarousel from "../components/ProjectsCarousel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getSite, getProjects } from "../lib/content";

const site = getSite();
const projects = getProjects();
const featuredProjects = projects.slice(0, 6);

const title = `${site.name} — ${site.tagline}`;
const description = site.bio.slice(0, 160);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  description: site.bio,
  url: "https://astridhati.github.io/",
  jobTitle: site.tagline,
  sameAs: Object.values(site.social ?? {}).filter(Boolean),
};
---

<Layout title={title} description={description} image={site.logo} jsonLd={jsonLd}>
  <Hero site={site} />

  <section class="projects section" aria-labelledby="projects-title">
    <div class="container">
      <h2 id="projects-title" class="section-title">Progetti</h2>
      <ProjectsCarousel projects={projects} />
      {projects.length > 0 && (
        <p class="section-cta">
          <a href="/progetti/" class="contact-button">Vedi tutti i progetti</a>
        </p>
      )}
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="section" aria-labelledby="featured-title">
        <div class="container">
          <h2 id="featured-title" class="section-title">In evidenza</h2>
          <div class="projects-grid" role="list">
            {featuredProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="contact section" aria-labelledby="home-cta-title">
    <div class="container">
      <h2 id="home-cta-title" class="section-title">Commissioni</h2>
      <p class="contact-intro">Per commissioni o collaborazioni, scrivimi.</p>
      <a href="/contatti/" class="contact-button">Contattami</a>
    </div>
  </section>
</Layout>

<style lang="scss">
  @use "../styles/breakpoints" as *;

  .section-cta {
    text-align: center;
    margin-top: var(--space-md);
  }

  .projects-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;

    @include from-sm {
      grid-template-columns: repeat(2, 1fr);
    }

    @include from-lg {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
